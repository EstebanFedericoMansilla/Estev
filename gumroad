    <script>
        // Reproductor de muestras (usa <audio id="samplePlayer">)
        const player = document.getElementById('samplePlayer');
        let activeBtn = null;
        function playSample(src, btn){
            try{
                if(activeBtn && activeBtn !== btn) activeBtn.textContent = 'Play';
                if(player.src && player.src.endsWith(encodeURI(src)) && !player.paused){
                    player.pause();
                    btn.textContent = 'Play';
                    return;
                }
                player.src = src;
                player.play().catch(()=>{ window.open('https://estebanmansilla.gumroad.com/','_blank'); });
                if(activeBtn && activeBtn !== btn) activeBtn.textContent = 'Play';
                activeBtn = btn;
                btn.textContent = 'Pause';
                player.onended = ()=>{ if(activeBtn) activeBtn.textContent = 'Play'; activeBtn = null; };
            }catch(e){
                // Si ocurre un error, abrir Gumroad como fallback
                window.open('https://estebanmansilla.gumroad.com/','_blank');
            }
        }

        // Copiar al portapapeles con fallback robusto
        async function copyToClipboard(text, btn){
            const original = btn.textContent;
            try{
                if(navigator.clipboard && navigator.clipboard.writeText){
                    await navigator.clipboard.writeText(text);
                    btn.textContent = 'Copiado';
                    setTimeout(()=> btn.textContent = original, 1600);
                    return;
                }
            }catch(e){ }

            // Fallback: usar textarea temporal + execCommand('copy')
            try{
                const ta = document.createElement('textarea');
                ta.value = text;
                ta.style.position = 'fixed';
                ta.style.left = '-9999px';
                document.body.appendChild(ta);
                ta.focus();
                ta.select();
                const ok = document.execCommand('copy');
                document.body.removeChild(ta);
                if(ok){
                    btn.textContent = 'Copiado';
                    setTimeout(()=> btn.textContent = original, 1600);
                    return;
                }
            }catch(e){ }

            // Último recurso: mostrar prompt con el enlace para copiar manualmente
            try{ prompt('Copia este enlace y pégalo en tu navegador:', text); }
            catch(e){ window.open(text, '_blank'); }
            btn.textContent = original;
        }

        // Mostrar/ocultar campo con la URL para permitir selección manual
        function toggleUrlField(btn, url){
            const album = btn.closest('.album');
            if(!album) return;
            const box = album.querySelector('.linkbox');
            if(!box) return;
            const input = box.querySelector('.urlfield');
            if(box.style.display === 'none' || box.style.display === ''){
                box.style.display = 'block';
                input.focus();
                input.select();
            } else {
                box.style.display = 'none';
            }
        }
    </script>
